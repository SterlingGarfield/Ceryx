{
  "name": "@ceryx/feature-remote-control",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @ceryx/client-sdk build",
    "build": "tsc -p tsconfig.json",
