{
  "name": "@ceryx/ipad",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "pnpm --filter @ceryx/feature-remote-control build",
    "build": "vite build",
    "pretypecheck": "pnpm --filter @ceryx/feature-remote-control build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @ceryx/feature-remote-control build",
    "test": "vitest run --environment jsdom"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@ceryx/client-sdk": "workspace:^",
    "@ceryx/design-tokens": "workspace:*",
    "@ceryx/feature-remote-control": "workspace:^",
    "@ceryx/protocol": "workspace:^",
    "@ceryx/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.5.2",
    "jsdom": "^26.1.0",
    "vite": "^7.2.0"
  }
}
