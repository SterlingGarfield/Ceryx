{
  "name": "ceryx",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "boundary:check": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"powershell -ExecutionPolicy Bypass -File .\\scripts\\check-disk-boundary.ps1\"",
    "boundary:migrate": "powershell -ExecutionPolicy Bypass -File .\\scripts\\migrate-c-to-d.ps1",
    "build": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"pnpm exec turbo run build\"",
    "typecheck": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"pnpm exec turbo run typecheck\"",
    "test": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"pnpm exec turbo run test\"",
    "lint": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"pnpm exec turbo run lint\"",
    "dev:ipad": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"pnpm --filter @ceryx/ipad dev\"",
    "dev:desktop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"pnpm --filter @ceryx/desktop dev\"",
    "dev:agent": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"dotnet run --project agent/windows/src/Ceryx.Agent.App/Ceryx.Agent.App.csproj\"",
    "test:agent": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"dotnet test agent/windows/Ceryx.Agent.Windows.sln\"",
    "test:agent:performance": "powershell -ExecutionPolicy Bypass -File .\\scripts\\use-disk-boundary.ps1 -Command \"dotnet test agent/windows/Ceryx.Agent.Windows.sln --filter Category=W7PerformanceMeasurement\""
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "pnpm": "9.15.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
